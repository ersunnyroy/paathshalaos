{
  "openapi": "3.1.0",
  "info": {
    "title": "paathshalaOS API",
    "version": "1.0.0",
    "description": "The integration surface for an institute running on paathshalaOS.\n\n**Money is a string.** Every amount is an exact decimal rendered as a string. Parsing one into a float is the single most common way an integration ends up disagreeing with a school about what a family owes.\n\n**Paging is keyset.** Follow `next_cursor`; there is no offset parameter, because a row inserted mid-walk would make an offset client skip a child.\n\n**Every write needs an `Idempotency-Key`.** Not optional — a client that omits one is refused.\n\n**Scopes are enforced by the database.** A key without `invoices:read` does not get filtered results from the invoice tables; it gets none, because the row-level security policy that decides is false for it."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your key, as `<prefix>.<secret>`. The prefix identifies the key and is safe to log; the secret after the dot is shown once, when the key is issued, and is never retrievable afterwards."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "validation_error",
                  "authentication_error",
                  "permission_error",
                  "not_found",
                  "conflict",
                  "rate_limited",
                  "provider_error",
                  "internal_error"
                ]
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "doc_url": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "issue": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "issue"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "code",
              "message",
              "request_id",
              "doc_url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "x-webhook-events": [
    {
      "type": "support.ticket.raised",
      "when": "Somebody raises a support ticket."
    }
  ],
  "x-webhook-signature": {
    "header": "X-Paathshala-Signature",
    "format": "t=<unix seconds>,v1=<hex>[,v1=<hex>]",
    "algorithm": "HMAC-SHA256 over `{t}.{raw request body}`",
    "tolerance_seconds": 300,
    "notes": [
      "Compare in constant time. A verifier written with === leaks, byte by byte, how much of a guess was right.",
      "Sign the RAW body. Re-serialising parsed JSON changes key order and number formatting, and the signature stops matching.",
      "More than one v1 may be present during a secret rotation; accept the request if any of them matches.",
      "Reject a timestamp more than 300 seconds from now, before doing the HMAC, so replayed requests cost you nothing."
    ]
  },
  "paths": {
    "/api/v1/students": {
      "get": {
        "operationId": "listStudents",
        "summary": "List learners",
        "description": "Active learners, oldest id first. Name parts are returned separately rather than concatenated, because every consumer splits a full name differently. Medical notes and emergency contacts are deliberately not in this response.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-scopes": [
          "students:read"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "next_cursor"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "admission_no": {
                            "type": "string"
                          },
                          "lifecycle_status": {
                            "type": "string"
                          },
                          "given_name": {
                            "type": "string"
                          },
                          "middle_name": {
                            "type": "string",
                            "nullable": true
                          },
                          "family_name": {
                            "type": "string",
                            "nullable": true
                          },
                          "preferred_name": {
                            "type": "string",
                            "nullable": true
                          }
                        },
                        "required": [
                          "id",
                          "admission_no",
                          "lifecycle_status",
                          "given_name",
                          "middle_name",
                          "family_name",
                          "preferred_name"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as `cursor` for the next page. Null on the last page."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing, malformed, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The key lacks the students:read scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded for this key. `Retry-After` says when the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The `next_cursor` from the previous page. Keyset, not offset: a row inserted mid-walk shifts every later offset page by one, so an offset client silently skips a record.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The `next_cursor` from the previous page. Keyset, not offset: a row inserted mid-walk shifts every later offset page by one, so an offset client silently skips a record."
            }
          }
        ]
      }
    },
