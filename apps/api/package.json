{
  "name": "@paathshala/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && node scripts/copy-assets.mjs && node dist/openapi/emit.js",
    "dev": "concurrently -n tsc,api -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:bootstrap": "pnpm run build && node dist/db/bootstrap.js",
    "db:migrate": "pnpm run build && node dist/db/migrate.js",
    "db:seed": "pnpm run build && node dist/db/seed.js",
    "webhooks:relay": "node dist/workers/webhook-relay.js",
    "webhooks:relay:dev": "pnpm run build && node dist/workers/webhook-relay.js",
    "db:schema": "pnpm run build && node dist/db/schema-doc.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^2.2.1",
    "@paathshala/offline-queue": "workspace:*",
    "ajv": "^8.20.0",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
