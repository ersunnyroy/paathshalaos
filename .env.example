# Copy to .env and adjust. Ports are offset (5433/6380) so they do not collide
# with a Postgres or Redis you may already run locally.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Owner role: owns the schema, runs migrations. Never used to serve requests.
DATABASE_OWNER_URL=postgres://paathshala_owner:local_dev_only@localhost:5433/paathshala

# Application role: NOT a superuser, no BYPASSRLS. This is the only role the API uses.
DATABASE_URL=postgres://paathshala_app:local_dev_only@localhost:5433/paathshala

REDIS_URL=redis://localhost:6380

# Login and token refresh only — no privileges on any tenant table.
DATABASE_AUTH_URL=postgres://paathshala_auth:local_dev_only@localhost:5433/paathshala

# Generate with: openssl rand -base64 48
JWT_SECRET=dev_only_secret_change_me_at_least_32_chars_long
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=60
